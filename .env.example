# Copy to .env for local Compose usage. Never commit the populated file.
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=southrail
JWT_ACCESS_TOKEN_TTL=20
JWT_REFRESH_TOKEN_TTL=14
CORS_ALLOWED_ORIGINS=http://localhost:8088
APP_FRONTEND_URL=http://localhost:8088
MAIL_FROM=noreply@example.invalid
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CONNECT_TIMEOUT=3000
GEMINI_READ_TIMEOUT=10000
AI_RAG_ENABLED=true
AI_RAG_MAX_CHUNKS=4
AI_RAG_RELEVANCE_THRESHOLD=0.42
AI_RAG_MAX_CHUNK_CHARACTERS=1800
SLOW_REQUEST_THRESHOLD=2s
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
RAZORPAY_RECONCILIATION_ENABLED=true
RAZORPAY_RECONCILIATION_DELAY=PT1M
RAZORPAY_RECONCILIATION_STALE_AFTER=PT5M
RAZORPAY_CREATION_EXPIRY=PT30M
RAZORPAY_RECONCILIATION_BATCH_SIZE=20
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
